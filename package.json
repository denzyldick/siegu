{
  "name": "siegu",
  "private": true,
  "version": "0.1.0",
  "license": "FSL-1.1-Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check:translations": "node scripts/check-translations.js",
    "format": "prettier --write \"src/**/*.{js,vue,ts,css,json}\" && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check \"src/**/*.{js,vue,ts,css,json}\" && cargo fmt --check --manifest-path src-tauri/Cargo.toml",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "prepare": "git config core.hooksPath .githooks",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "@mdi/font": "^7.4.47",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "~2",
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "pinia": "^4.0.2",
    "pinia-plugin-persistedstate": "^4.7.1",
    "simple-icons": "^16.27.1",
    "vue": "^3.5.35",
    "vue-i18n": "^11.4.5",
    "vue-virtual-scroller": "^3.0.4",
    "vuetify": "^4.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.10.2",
    "prettier": "^3.9.5",
    "prettier-plugin-vue": "^1.1.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.8"
  }
}
