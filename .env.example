# Siegu app environment overrides (dev). Copy to `.env` and edit.
# Vite exposes only variables prefixed with VITE_ to the client.

# Landing page + share upsell links. Point this at the local landing site
# (run `npm run dev` in the sibling `siegu-landing` repo) so "siegu.io"
# links open the locally-served marketing site instead of the hosted domain.
# VITE_APP_LANDING_URL=http://127.0.0.1:4174/

# Source repository (open source project).
# VITE_APP_GITHUB_URL=https://github.com/denzyldick/siegu

# User documentation (source docs folder on GitHub).
# VITE_APP_DOCS_URL=https://github.com/denzyldick/siegu/tree/main/docs

# Signalling WebSocket endpoint (default managed relay).
# VITE_SIGNALING_URL=wss://siegu.io/ws
