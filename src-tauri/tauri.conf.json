{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Siegu",
  "version": "0.1.1",
  "identifier": "io.denzyl.siegu",
  "build": {
    "beforeDevCommand": "yarn dev -- --host",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Siegu",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: localhost; img-src 'self' data: tauri: asset: http://asset.localhost http://127.0.0.1:*; media-src 'self' tauri: asset: http://asset.localhost http://127.0.0.1:*; frame-src 'self' tauri: localhost; connect-src 'self' tauri: localhost http://127.0.0.1:* https://github.com;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$HOME/**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "untrusted comment: minisign public key: F47C9C3C0262F6B8\nRWS49mICPJx89EDOsGP6TsksXNE+j5T+P7JWZFfKWItN/huO3g8HcRek",
      "endpoints": [
        "https://github.com/denzyldick/siegu/releases/latest/download/latest.json"
      ]
    },
    "notification": null
  },
    "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "shortDescription": "Privacy-first local media management.",
    "longDescription": "Siegu is a cross-platform, privacy-first media backup and synchronization application.",
    "fileAssociations": [
      {
        "ext": ["jpg", "jpeg", "png", "gif", "webp", "bmp", "svg", "heic", "heif", "avif"],
        "name": "Siegu Image",
        "description": "Open image in Siegu",
        "mimeType": "image/*",
        "role": "Viewer"
      },
      {
        "ext": ["mp4", "webm", "mov", "avi", "mkv", "m4v"],
        "name": "Siegu Video",
        "description": "Open video in Siegu",
        "mimeType": "video/*",
        "role": "Viewer"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "Graphics"
      }
    }
  }
}