{
	# Trusted proxies not needed (public server edges directly).
	admin off
}

{$SITE_ADDR:siegu.io} {
	encode gzip

	root * /srv

	# Extensionless subpages: /pricing -> pricing.html, /faq -> faq.html, etc.
	@noext {
		path_regexp noext ^/([a-zA-Z0-9_-]+)/?$
		not path_regexp has_ext \.([a-z0-9]+)$
	}
	rewrite @noext /{re.noext.1}.html

	try_files {path} {path}/ /index.html
	file_server

	# Local:  SIEGU_CERT_ISSUER=internal (default) -> internal CA, hosts file entry.
	# VPS:    SIEGU_CERT_ISSUER=acme           -> automatic Let's Encrypt.
	tls {$CERT_ISSUER:internal}
}
