#############################
# Generated by entrypoint.sh from the SIEGU_DOMAIN env var.
#   - SIEGU_DOMAIN=""        -> :80   (plain HTTP, for localhost / LAN)
#   - SIEGU_DOMAIN=app.x.com -> https://app.x.com  (Caddy automatic TLS)
#############################

{SITE_ADDR} {
	encode gzip
	# The Rust `siegu web` host serves the UI, embedded signalling (/ws), and
	# the room code (/session). Caddy is the TLS/HTTP edge in front of it.
	reverse_proxy siegu-host:8787
}
